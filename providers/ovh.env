# providers/ovh.env — see providers/README.md
export STORAGE_CLASS=csi-cinder-high-speed-gen2
export MIN_KUBERNETES_VERSION=1.30
# LoadBalancer: auto-provisions via OVHcloud's own cloud-controller-manager
# (Octavia) — no extra component needed, unlike Kind's cloud-provider-kind.
# NetworkPolicy enforcement: Free plan ships Canal CNI with Calico policy
# support — expected to enforce by default, but confirm live with
# lib/check-networkpolicy.sh rather than assuming.
