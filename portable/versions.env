# portable/versions.env — every component version pin for the portable
# path, in one place. Portable only — the OpenShift path installs
# Strimzi via OperatorHub, Tekton via the OpenShift Pipelines Operator,
# and has no ingress-nginx/Calico/Kind at all, so none of this touches it.
#
# Sourced by: kafka/portable/prerequisites/install-strimzi.sh,
# pipeline/portable/prerequisites/install-tekton.sh,
# pipeline/portable/prerequisites/install-tekton-dashboard.sh,
# ingress/portable/prerequisites/install-ingress-nginx.sh,
# ingress/portable/prerequisites/install-cloud-provider-kind.sh,
# portable/scripts/teardown-prerequisites.sh, and the Kind-cluster-creation
# commands in onboarding/portable/README.md and kafka/portable/README.md.
#
# No secrets — public, non-sensitive version strings. Committed directly.

export STRIMZI_VERSION=0.51.0
export TEKTON_PIPELINES_VERSION=v1.15.3
export TEKTON_DASHBOARD_VERSION=v0.72.0
export INGRESS_NGINX_VERSION=controller-v1.15.1
export CALICO_VERSION=v3.32.2
export KIND_NODE_IMAGE=kindest/node:v1.34.11
export CPK_VERSION=0.11.1
