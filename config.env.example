# Multi-Tenant Kafka + NiFi Infrastructure Configuration
# Copy this to config.env and edit with your actual values

# ============================================================================
# NAMESPACE MAPPING
# ============================================================================
# ROLE                    NAMESPACE NAME              DESCRIPTION
# Shared Infrastructure   infra                       Shared Event Generator
# Team Namespaces         team-01, team-02, etc.      Individual team project spaces
# ============================================================================

# Infrastructure namespace - SHARED INFRASTRUCTURE
# IMPORTANT: You must create this namespace before deploying
export INFRA_NAMESPACE=infra

# Team namespace prefix (teams will be named ${TEAM_NAMESPACE_PREFIX}-01, -02, etc.)
export TEAM_NAMESPACE_PREFIX=team
# Team namespace — set to your actual namespace (may differ from the prefix convention)
export TEAM_NAMESPACE="team-01"
# Team name — used as identifier when deploying Kafka (e.g., team01, team02)
export TEAM_NAME="team01"

# Kafka configuration
export KAFKA_CLUSTER_NAME=kafka-cluster

# NiFi configuration
export NIFI_CLUSTER_NAME=nifi-cluster
# OpenShift-compatible NiFi image (no anyuid SCC required)
# Source: https://github.com/bu-cds-ds551/ds551-nifi
export NIFI_IMAGE=quay.io/langdon/nifi-openshift:latest
# OpenShift: oc get ingresses.config/cluster -o jsonpath='{.spec.domain}'
# Vanilla Kubernetes: not needed (use Ingress instead of Route)
export EXTERNAL_DOMAIN=apps.your-cluster.example.com

# Storage class for PVCs (adjust to your cluster's available storage classes)
# Examples: gp2, gp3, standard, hostpath
export STORAGE_CLASS=standard

# External Kafka access (if using NodePort) -  In case of shared cluster
export KAFKA_EXTERNAL_HOST="your-cluster-external-ip"
export KAFKA_EXTERNAL_PORT="30092"

# ----------------------------------------------------------------------------
# Event Generator Configuration
# ----------------------------------------------------------------------------
# Event generator deployment name
export EVENT_GENERATOR_NAME=event-generator

# Git repository for building event generator (Git source - recommended)
# Update this to your forked repository URL
export GIT_REPO_URL="https://github.com/YOUR-USERNAME/data-eng-at-scale-infra.git"
export GIT_BRANCH="main"

# NOTE: For local development with Binary source, comment out the Git source
# in event-generator/k8s/02-buildconfig.yaml and uncomment the Binary source

# ----------------------------------------------------------------------------
# Mode 1: Multi-Team (CURRENTLY ACTIVE)
# ----------------------------------------------------------------------------
# Number of teams/tenants to support
export NUM_TEAMS=10

# Team Kafka bootstrap server mapping (multi-team mode)
# Format: team_id=kafka-service.namespace.svc.cluster.local:9092
# Add more teams separated by commas
export TEAM_BOOTSTRAP_SERVERS="team01=kafka-team01.team-01.svc.cluster.local:9092,team02=kafka-team02.team-02.svc.cluster.local:9092"

# Topic naming pattern: ${TOPIC_PREFIX}${TEAM_ID}${TOPIC_SUFFIX}
# Example: events.team00.raw
export TOPIC_PREFIX="events."
export TOPIC_SUFFIX=".raw"

# ----------------------------------------------------------------------------
# Mode 2: Single Shared Cluster (COMMENTED OUT - Uncomment to use)
# ----------------------------------------------------------------------------
# To switch to single-cluster mode:
# 1. Comment out TEAM_BOOTSTRAP_SERVERS above
# 2. Uncomment KAFKA_BOOTSTRAP_SERVERS below
# 3. Optionally set TOPIC to override topic naming

# KAFKA_BOOTSTRAP_SERVERS="kafka-cluster.infra.svc.cluster.local:9092"
# TOPIC="events.raw"  # Optional: explicit topic name (overrides TOPIC_PREFIX/SUFFIX)

# ----------------------------------------------------------------------------
# Common Event Generator Settings
# ----------------------------------------------------------------------------
# Event generation rate (events per second)
export EVENT_RATE_PER_SEC="10"

# When true, EVENT_RATE_PER_SEC applies per team; when false, total rate across all teams
export RATE_PER_TEAM="false"

# Event types to generate (comma-separated)
export EVENT_STREAMS="symptom_report,clinic_visit,environmental_conditions"

# Geographic regions for simulation (comma-separated)
export REGIONS="Boston,NYC,Chicago,Seattle,Austin"

# Optional: Seed for Python's random number generator — makes generated events reproducible
# across restarts. Useful for demos, testing, or comparing student pipelines on identical data.
# Accepts an integer (e.g. 42) or any string (hashed to an int internally).
# WARNING: setting RANDOM_SEED="" (empty string) still seeds with 0 — output will be deterministic.
# To get truly non-deterministic (random) output, leave this line commented out entirely.
# export RANDOM_SEED="42"

# ----------------------------------------------------------------------------
# Tekton Pipeline Configuration
# Used by: tekton/rbac/, tekton/tasks/, tekton/pipelines/, tekton/runs/
# Apply any Tekton file with:
#   source config.env && envsubst '${VAR1} ${VAR2}' < file.yaml | oc apply -f -
# See each file's header comment for the exact envsubst vars to pass.
# ----------------------------------------------------------------------------

# Service account that runs all Tekton pipeline tasks (cross-namespace deploy)
export TEKTON_SA_NAME=pipeline-runner

# OpenShift CLI image used inside every task step
export OC_CLI_IMAGE=image-registry.openshift-image-registry.svc:5000/openshift/cli:latest

# PVC storage size created per PipelineRun for the shared workspace
# Only needs to hold the cloned git repo (~10MB) — keep this small
export TEKTON_WORKSPACE_SIZE=100Mi

# Workspace PVC to reuse for TaskRuns (set this after the first PipelineRun)
# Find it with: oc get pvc -n ${INFRA_NAMESPACE} | grep shared-data
# Example: shared-data-deploy-team01-run-001
export TEKTON_WORKSPACE_PVC=""

# ----------------------------------------------------------------------------
# Multi-Team Deployment (used by tekton/runs/run-all-teams.yaml and run-reset-all-teams.yaml)
# Single-team runs reuse TEAM_NAME / TEAM_NAMESPACE / TEAM_BOOTSTRAP_SERVERS above.
# For all-teams run: update TEAM_BOOTSTRAP_SERVERS to include all teams comma-separated.
# ----------------------------------------------------------------------------

export TEAM1_NAME=team01
export TEAM1_NAMESPACE=team-01

export TEAM2_NAME=team02
export TEAM2_NAMESPACE=team-02

# Teams 3-15: set to your actual values when deploying those teams.
# Leave as "skip" to skip that team's Kafka deploy in run-all-teams.yaml.
export TEAM3_NAME=skip
export TEAM3_NAMESPACE=skip

export TEAM4_NAME=skip
export TEAM4_NAMESPACE=skip

export TEAM5_NAME=skip
export TEAM5_NAMESPACE=skip

export TEAM6_NAME=skip
export TEAM6_NAMESPACE=skip

export TEAM7_NAME=skip
export TEAM7_NAMESPACE=skip

export TEAM8_NAME=skip
export TEAM8_NAMESPACE=skip

export TEAM9_NAME=skip
export TEAM9_NAMESPACE=skip

export TEAM10_NAME=skip
export TEAM10_NAMESPACE=skip

export TEAM11_NAME=skip
export TEAM11_NAMESPACE=skip

export TEAM12_NAME=skip
export TEAM12_NAMESPACE=skip

export TEAM13_NAME=skip
export TEAM13_NAMESPACE=skip

export TEAM14_NAME=skip
export TEAM14_NAMESPACE=skip

export TEAM15_NAME=skip
export TEAM15_NAMESPACE=skip
