# onboarding/cluster.env.example — Cluster Onboarding Configuration
#
# Used by: onboarding/apply-onboarding.sh
# These are one-time cluster setup values — not needed again after namespaces
# are created. Keep separate from config.env (which is used by Tekton pipelines
# at runtime).
#
# Setup:
#   cp onboarding/cluster.env.example onboarding/cluster.env
#   # edit onboarding/cluster.env with your values
#   bash onboarding/apply-onboarding.sh --dry-run
#   bash onboarding/apply-onboarding.sh
#
# NOTE: onboarding/cluster.env is gitignored — never commit it.

# ============================================================================
# Cluster identity — must match values you will set in config.env
# ============================================================================
export INFRA_NAMESPACE=infra
export TEAM_NAMESPACE_PREFIX=team

# Number of team namespaces to create (team-01 through team-NN)
export NUM_TEAMS=3

# Storage class available on your cluster
# CRC (local dev):
export STORAGE_CLASS=crc-csi-hostpath-provisioner
# NERC OpenShift:
# export STORAGE_CLASS=standard
# Other clusters: run 'oc get storageclass' to list available classes

# ============================================================================
# ResourceQuota + LimitRange for infra namespace
# Sized larger than team namespaces — infra runs shared cluster-level workloads
# ============================================================================
# CRC:
export INFRA_RESOURCE_QUOTA_CPU=4
export INFRA_RESOURCE_QUOTA_MEMORY=6Gi
export INFRA_RESOURCE_QUOTA_STORAGE=30Gi

export INFRA_LIMIT_POD_CPU_MAX=4
export INFRA_LIMIT_POD_MEM_MAX=6Gi
export INFRA_LIMIT_CONTAINER_CPU_MAX=2
export INFRA_LIMIT_CONTAINER_MEM_MAX=3Gi
export INFRA_LIMIT_CONTAINER_CPU_DEFAULT=500m
export INFRA_LIMIT_CONTAINER_MEM_DEFAULT=512Mi
export INFRA_LIMIT_CONTAINER_CPU_REQUEST=100m
export INFRA_LIMIT_CONTAINER_MEM_REQUEST=256Mi

# NERC / cloud (uncomment and adjust):
# export INFRA_RESOURCE_QUOTA_CPU=16
# export INFRA_RESOURCE_QUOTA_MEMORY=32Gi
# export INFRA_RESOURCE_QUOTA_STORAGE=100Gi
# export INFRA_LIMIT_POD_CPU_MAX=8
# export INFRA_LIMIT_POD_MEM_MAX=16Gi
# export INFRA_LIMIT_CONTAINER_CPU_MAX=4
# export INFRA_LIMIT_CONTAINER_MEM_MAX=8Gi
# export INFRA_LIMIT_CONTAINER_CPU_DEFAULT=500m
# export INFRA_LIMIT_CONTAINER_MEM_DEFAULT=512Mi
# export INFRA_LIMIT_CONTAINER_CPU_REQUEST=100m
# export INFRA_LIMIT_CONTAINER_MEM_REQUEST=256Mi

# ============================================================================
# ResourceQuota per team namespace
# ============================================================================
# CRC (local dev — conservative to share CRC's ~16GB RAM):
export RESOURCE_QUOTA_CPU=2
export RESOURCE_QUOTA_MEMORY=3Gi
export RESOURCE_QUOTA_STORAGE=20Gi

# NERC / cloud (uncomment and adjust):
# export RESOURCE_QUOTA_CPU=8
# export RESOURCE_QUOTA_MEMORY=16Gi
# export RESOURCE_QUOTA_STORAGE=100Gi

# ============================================================================
# LimitRange per team namespace
# Sets default requests/limits so pods don't need to declare them explicitly.
# ============================================================================
# CRC defaults (small — fits Kafka + NiFi on a 16GB laptop):
export LIMIT_POD_CPU_MAX=2
export LIMIT_POD_MEM_MAX=4Gi
export LIMIT_CONTAINER_CPU_MAX=1
export LIMIT_CONTAINER_MEM_MAX=2Gi
export LIMIT_CONTAINER_CPU_DEFAULT=200m
export LIMIT_CONTAINER_MEM_DEFAULT=256Mi
export LIMIT_CONTAINER_CPU_REQUEST=50m
export LIMIT_CONTAINER_MEM_REQUEST=128Mi

# NERC / cloud (uncomment and adjust):
# export LIMIT_POD_CPU_MAX=4
# export LIMIT_POD_MEM_MAX=8Gi
# export LIMIT_CONTAINER_CPU_MAX=2
# export LIMIT_CONTAINER_MEM_MAX=4Gi
# export LIMIT_CONTAINER_CPU_DEFAULT=500m
# export LIMIT_CONTAINER_MEM_DEFAULT=512Mi
# export LIMIT_CONTAINER_CPU_REQUEST=100m
# export LIMIT_CONTAINER_MEM_REQUEST=256Mi

# ============================================================================
# Human user RBAC groups
# ============================================================================
# Group for teachers/TAs — gets edit access in infra namespace + all team namespaces
export INFRA_ADMIN_GROUP=infra-admins

# Suffix for per-team student groups: ${TEAM_NAMESPACE_PREFIX}-${TEAM_ID}-${TEAM_GROUP_SUFFIX}
# e.g., team-01-devs, team-02-devs, team-03-devs
export TEAM_GROUP_SUFFIX=devs

# After running apply-onboarding.sh, add users to groups:
#   oc adm groups add-users infra-admins <teacher-username>
#   oc adm groups add-users team-01-devs <student-username>
#
# On CRC (only 'developer' user available — simulate all roles with one user):
#   oc adm groups add-users infra-admins developer
#   oc adm groups add-users team-01-devs developer
